<!doctype html>
<html lang="{{ lang or 'ru' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ chapter_title }}</title>
  <link rel="stylesheet" href="./assets/katex.min.css">
  <link rel="stylesheet" href="./assets/course.css">
  <script defer src="./assets/katex.min.js"></script>
  <script defer src="./assets/Sortable.min.js"></script>
  <script defer src="./assets/course.js"></script>
</head>
{% macro src(page, model=true) -%}
<span class="src prov-{{ prov_code(model) }}" title="{{ prov_title(model) }}">стр. {{ page }} · {{ prov_label(model) }}</span>
{%- endmacro %}
{% macro pages(list) -%}
{% for p in list %}{{ p }}{% if not loop.last %}, {% endif %}{% endfor %}
{%- endmacro %}
{% macro quote(c) %}
<div class="quote" id="claim-{{ c.id }}">
  <p class="quote-claim"><span class="kind">{{ c.kind }}</span> {{ c.html }}</p>
  <blockquote>{{ c.quote }} {{ src(c.page, false) }}</blockquote>
</div>
{% endmacro %}
{% macro table(tb) %}
<p><b>{{ tb.caption or 'Таблица' }}</b> {{ src(tb.page, false) }}</p>
<div class="table-scroll wide" tabindex="0" role="region" aria-label="Таблица книги, стр. {{ tb.page }}"><table>
  <thead><tr>{% for h in tb.headers %}<th>{{ h }}</th>{% endfor %}</tr></thead>
  <tbody>{% for r in tb.rows %}<tr>{% for cell in r %}<td>{{ cell }}</td>{% endfor %}</tr>{% endfor %}</tbody>
</table></div>
{% endmacro %}
{% macro picture(file, phone, alt) -%}
<picture>{% if phone %}<source media="(max-width: 560px)" srcset="./{{ phone }}">{% endif %}<img src="./{{ file }}" alt="{{ alt }}" width="560"></picture>
{%- endmacro %}
{% macro evidence(q) %}
{% if q.extra %}
<ul class="facts">
  {% for c in q.extra %}
  <li id="claim-{{ c.id }}">{{ c.html }} {{ src(c.page, c.prov) }}
    <details class="quotes"><summary>Цитата автора</summary><blockquote>{{ c.quote }} {{ src(c.page, false) }}</blockquote></details>
  </li>
  {% endfor %}
</ul>
{% endif %}
{% if q.quotes %}
<details class="quotes">
  <summary>Цитаты автора: {{ q.quotes|length }}</summary>
  {% for c in q.quotes %}{{ quote(c) }}{% endfor %}
</details>
{% endif %}
{% for nt in q.notes %}<p class="ed-note">Пометка к тексту книги: {{ nt }}</p>{% endfor %}
{% endmacro %}
{% macro para(q) %}
<div class="para">
  {% if q.text %}<p>{{ q.html }} {{ src(pages(q.pages), q.prov) }}</p>{% endif %}
  {{ evidence(q) }}
</div>
{% endmacro %}
<body>
  <a class="skip-link" href="#main-content">Перейти к содержанию</a>
  <header class="topbar">
    <div class="topbar-inner">
      <div class="brand">
        <h1 class="brand-title">{{ chapter_title }}</h1>
        <p class="brand-sub"><span id="progress-label">Пройдено 0 из {{ steps|length }}</span> · около {{ total_minutes }} мин · <span id="save-status">прогресс</span></p>
      </div>
      <div class="controls">
        <label class="sr-only" for="theme-select">Тема оформления</label>
        <select id="theme-select" class="btn">
          <option value="auto">Тема: авто</option>
          <option value="light">Светлая</option>
          <option value="dark">Тёмная</option>
        </select>
        <button type="button" class="btn" id="export-progress" title="Сохранить прогресс в файл">Сохранить</button>
        <label class="btn" title="Загрузить прогресс из файла">Загрузить<input type="file" id="import-progress" accept="application/json" hidden></label>
      </div>
    </div>
    <nav class="tabs-bar" aria-label="Разделы курса">
      <button type="button" class="tab-btn mobile-only" id="drawer-toggle" aria-expanded="false" aria-controls="sidebar-nav">Шаги</button>
      <button type="button" class="tab-btn" data-tab="step" aria-selected="true">Урок</button>
      <button type="button" class="tab-btn" data-tab="path" aria-selected="false">Путь</button>
      <button type="button" class="tab-btn" data-tab="map" aria-selected="false">Карта связей</button>
      <button type="button" class="tab-btn" data-tab="cards" aria-selected="false">Карточки</button>
      <button type="button" class="tab-btn" data-tab="glossary" aria-selected="false">Глоссарий</button>
      <button type="button" class="tab-btn" data-tab="summary" aria-selected="false">Конспект</button>
      <button type="button" class="tab-btn" data-tab="legend" aria-selected="false">Легенда цветов</button>
    </nav>
    <div class="progress-line" aria-hidden="true"><div class="progress-fill" id="progress-fill"></div></div>
  </header>

  <div class="layout">
    <aside class="sidebar" id="sidebar-nav" aria-label="Путь по главе">
      {% for p in parts %}
      <p class="part-title">Часть {{ p.n }}{% if p.title %}. {{ p.title }}{% endif %}</p>
      <ul class="path-list">
        {% for s in p.steps %}
        <li>
          <button type="button" class="path-item" data-step="{{ s.id }}" data-goto-step="{{ s.id }}">
            <span class="path-num">{{ s.order }}</span>
            <span class="path-name">{{ s.title }}</span>
            <span class="path-done" aria-hidden="true"></span>
          </button>
        </li>
        {% endfor %}
      </ul>
      {% endfor %}
    </aside>

    <main id="main-content" class="main">
      <div id="tab-step" class="tab-panel">
        {% for s in steps %}
        <article id="step-{{ s.id }}" class="panel step-section"{% if not loop.first %} hidden{% endif %}>
          <header class="step-head">
            <p class="part-label">{{ s.part_label }}</p>
            <h2>{{ s.title }}</h2>
            <p class="book-line">В книге: {{ s.title_book }} · стр. {{ s.pages_label }}</p>
            <div class="chips">
              <span class="chip">Шаг {{ s.order }} из {{ steps|length }}</span>
              <span class="chip">≈ {{ s.minutes }} мин</span>
              {% if s.difficulty %}<span class="chip">трудность: {{ s.difficulty }}</span>{% endif %}
              {% if s.threshold %}<span class="chip warn">пороговая идея</span>{% endif %}
            </div>
            {% if s.prereq %}
            <p class="prereq">Опирается на: {% for p in s.prereq %}<a href="#step-{{ p.id }}" data-goto-step="{{ p.id }}">{{ p.title }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
            {% endif %}
            {% if loop.first and volve %}{% set volve_steps = steps|selectattr('show_volve')|list %}{% set volve_step = volve_steps[0] if volve_steps else none %}{% if volve_step and volve_step.id != s.id %}
            <p class="volve-jump"><a href="#volve-widget" class="btn" data-goto-step="{{ volve_step.id }}">Попробовать на реальной скважине Volve →</a></p>
            {% endif %}{% endif %}
          </header>

          <section id="sec-{{ s.id }}-core" class="block core">
            <h3>Суть</h3>
            <p class="lead">{{ s.main_html }} {{ src(s.main_pages) }}</p>
            {% if s.why_here %}<p class="muted"><b>Почему сейчас.</b> {{ s.why_here }}</p>{% endif %}
          </section>

          {% if s.videos %}
          <section class="block">
            <h3>Видео</h3>
            {% for v in s.videos %}
            <figure class="video-card{% if v.vertical %} vertical{% endif %}">
              <video controls preload="metadata" src="./{{ v.file }}"{% if v.poster %} poster="./{{ v.poster }}"{% endif %} data-subtitles-id="{{ v.id }}"></video>
              <figcaption>{{ v.title }}</figcaption>
            </figure>
            {% endfor %}
          </section>
          {% endif %}

          {% if s.mechanism %}
          <section id="sec-{{ s.id }}-work" class="block">
            <h3>Как это работает</h3>
            {% for q in s.mechanism %}{{ para(q) }}{% endfor %}
          </section>
          {% endif %}

          {% if s.illustrations %}
          <section id="sec-{{ s.id }}-ill" class="block">
            <h3>{% if s.illustrations|selectattr('frames')|list %}Рисунок и модель{% else %}Рисунок{% endif %}</h3>
            {% for ill in s.illustrations %}
            <figure class="ill-card"{% if ill.frames %} data-frames="{{ ill.frames['items']|length }}"{% endif %}>
              {% if ill.frames %}
              {% for f in ill.frames['items'] %}
              <a href="./{{ f.file }}" target="_blank" rel="noopener" class="ill-frame" data-frame="{{ loop.index0 }}"{% if not loop.first %} hidden{% endif %}>{{ picture(f.file, f.phone, ill.alt ~ ' ' ~ ill.frames.label ~ ': ' ~ f.label ~ '.') }}</a>
              {% endfor %}
              <div class="frames-ui">
                <span class="frames-label">{{ ill.frames.label }}: <b class="frames-value" aria-live="polite">{{ ill.frames['items'][0].label }}</b></span>
                {% if ill.frames.ui == 'buttons' %}
                <div class="frames-btns" role="group" aria-label="{{ ill.frames.label }}">
                  {% for f in ill.frames['items'] %}<button type="button" class="btn frame-btn" data-frame-to="{{ loop.index0 }}" data-label="{{ f.label }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ f.label }}</button>{% endfor %}
                </div>
                {% else %}
                <input type="range" class="frame-range" min="0" max="{{ ill.frames['items']|length - 1 }}" step="1" value="0" aria-label="{{ ill.frames.label }}" data-labels="{{ ill.frames['items']|map(attribute='label')|join('|') }}">
                {% endif %}
              </div>
              {% else %}
              <a href="./{{ ill.file }}" target="_blank" rel="noopener">{{ picture(ill.file, ill.phone, ill.alt) }}</a>
              {% endif %}
              <figcaption><span class="chip">{{ ill.label }}</span> {{ ill.caption }}{% if ill.source %} <span class="muted">Источник: {{ ill.source }}.</span>{% endif %}</figcaption>
            </figure>
            {% endfor %}
          </section>
          {% endif %}

          {% if s.steps_list or s.practice or s.now_practice or s.lens %}
          <section class="block">
            <h3>{% if s.steps_list %}По шагам{% else %}На практике{% endif %}</h3>
            {% if s.steps_list %}
            <ol class="steps">{% for q in s.steps_list %}<li>{{ para(q) }}</li>{% endfor %}</ol>
            {% endif %}
            {% if s.practice %}
            {% if s.steps_list %}<h4>На практике</h4>{% endif %}
            {% for q in s.practice %}{{ para(q) }}{% endfor %}
            {% endif %}
            {% if s.now_practice %}
            <div class="callout"><p><b>Как это делают сейчас.</b> {{ s.now_practice }} <span class="src prov-external" title="{{ prov_title('external') }}">{{ prov_label('external') }}</span></p></div>
            {% endif %}
            {% if s.lens %}
            <details class="more">
              <summary>Где здесь ручной труд специалиста</summary>
              <dl class="lens">
                <dt>Вход</dt><dd>{{ s.lens.inputs }}</dd>
                <dt>Ручные шаги</dt><dd>{{ s.lens.manual_steps }}</dd>
                <dt>Точки суждения</dt><dd>{{ s.lens.judgment_points }}</dd>
                <dt>Время</dt><dd>{{ s.lens.time }}</dd>
                <dt>Типичные ошибки</dt><dd>{{ s.lens.typical_errors }}</dd>
              </dl>
            </details>
            {% endif %}
          </section>
          {% endif %}

          {% if s.examples %}
          <section class="block">
            <h3>Разбор примеров автора</h3>
            {% for ex in s.examples %}
            <div class="card">
              <p><b>Условие.</b> {{ ex.condition }} {{ src(ex.page) }}</p>
              <ol class="steps">{% for st in ex.steps %}<li>{{ st }}</li>{% endfor %}</ol>
              <p><b>Ответ.</b> {{ ex.result }}</p>
              {% if ex.figure %}<p class="muted">Опора примера: {{ ex.figure }}{% if s.illustrations %}, рисунок выше{% endif %}.</p>{% endif %}
            </div>
            {% endfor %}
          </section>
          {% endif %}

          {% if s.conditions %}
          <section class="block">
            <h3>Цифры и условия</h3>
            {% for q in s.conditions %}{{ para(q) }}{% endfor %}
          </section>
          {% endif %}

          {% if s.formulas %}
          <section class="block">
            <h3>Формулы</h3>
            {% for fm in s.formulas %}
            <div class="card formula">
              {% if fm.tex_rich %}<p class="formula-prose">{{ fm.tex_rich }}</p>{% else %}<div class="math-tex" data-tex="{{ fm.tex }}" data-display="true">{{ fm.tex }}</div>{% endif %}
              <p>{{ fm.meaning }} {{ src(fm.page, false) }}</p>
              {% for nt in fm.notes %}<p class="ed-note">Пометка к тексту книги: {{ nt }}</p>{% endfor %}
              {% if fm.raw_rich %}<details class="quotes"><summary>Как записано в файле главы</summary><p class="formula-prose">{{ fm.raw_rich }}</p></details>{% elif fm.raw %}<details class="quotes"><summary>Как записано в файле главы</summary><div class="math-tex" data-tex="{{ fm.raw }}" data-display="true">{{ fm.raw }}</div></details>{% endif %}
            </div>
            {% endfor %}
            {% if s.variables %}
            <div class="table-scroll"><table>
              <thead><tr><th>Обозначение</th><th>Что это</th><th>Единица</th></tr></thead>
              <tbody>{% for v in s.variables %}<tr><td><span class="math-tex" data-tex="{{ v.tex }}">{{ v.tex }}</span></td><td>{{ v.meaning }}</td><td>{{ v.unit }}</td></tr>{% endfor %}</tbody>
            </table></div>
            {% endif %}
          </section>
          {% endif %}

          {% if s.tables %}
          <section class="block">
            <h3>Таблицы книги</h3>
            {% for tb in s.tables %}{{ table(tb) }}{% endfor %}
          </section>
          {% endif %}

          {% if s.terms %}
          <section class="block">
            <h3>Новые понятия</h3>
            <dl class="terms">
              {% for g in s.terms %}<dt>{{ g.term }}{% if g.en %} <span class="en">{{ g.en }}</span>{% endif %}</dt><dd>{{ g.definition }}</dd>{% endfor %}
            </dl>
          </section>
          {% endif %}

          {% if s.misconception %}
          <section class="block">
            <h3>Частая ошибка</h3>
            <div class="callout bad"><p>{{ s.misconception }}</p></div>
          </section>
          {% endif %}

          {% if s.data_from or s.data_breaks or s.hypotheses or s.it_analogy %}
          <section id="sec-{{ s.id }}-data" class="block">
            <h3>Что это значит для данных</h3>
            {% if s.data_from %}<p><b>Из главы.</b> {{ s.data_from }}</p>{% endif %}
            {% if s.data_breaks %}<p><b>Где правило ломается.</b> {{ s.data_breaks }}</p>{% endif %}
            {% for h in s.hypotheses %}<p><span class="chip warn">гипотеза</span> {{ h }}</p>{% endfor %}
            {% if s.it_analogy %}
            <div class="callout">
              <p><b>Аналогия из ИТ.</b> {{ s.it_analogy.text }} <span class="src prov-external" title="{{ prov_title('external') }}">{{ prov_label('external') }}</span></p>
              <p><b>Где она перестаёт работать.</b> {{ s.it_analogy.breaks_where }}</p>
            </div>
            {% endif %}
          </section>
          {% endif %}

          {% if s.decision or (s.show_volve and volve) %}
          <section class="block">
            <h3>Решение на данных</h3>
            {% if s.decision %}
            <div class="card decision">
              <p><b>Признаки:</b></p>
              <ul class="facts">{% for f in s.decision.features %}<li>{{ f }}</li>{% endfor %}</ul>
              <p><b>Правило.</b> {{ s.decision.rule }}</p>
              <details class="more"><summary>Вывод и контрпример</summary>
                <p><b>Вывод.</b> {{ s.decision.conclusion }}</p>
                {% if s.decision.counterexample %}<p><b>Где правило ошибётся.</b> {{ s.decision.counterexample }}</p>{% endif %}
              </details>
            </div>
            {% endif %}
            {% if s.show_volve and volve %}
            <div class="volve-box" id="volve-widget">
              <p><b>Реальная скважина Volve {{ volve.well }}.</b> Три интервала по 5 метров. Передвиньте ползунок глубины, сравните показания и выберите интервал, который даст нефть. Правило оператора для коллектора: <code>{{ volve.operator_rule.condition }}</code>.</p>
              <div class="volve-controls">
                <label>Интервал
                  <select class="input-text volve-interval">
                    {% for iv in volve.intervals %}<option value="{{ iv.id }}">{{ iv.id }}</option>{% endfor %}
                  </select>
                </label>
                <label class="grow"><span>Глубина: <b class="volve-depth-val">—</b></span>
                  <input type="range" class="volve-depth" min="0" max="49" value="0">
                </label>
              </div>
              <div class="volve-grid">
                <div class="metric-tile"><span>GR, гамма</span><b class="m-gr">—</b></div>
                <div class="metric-tile"><span>RT, сопротивление</span><b class="m-rt">—</b></div>
                <div class="metric-tile"><span>PHIF, пористость</span><b class="m-phif">—</b></div>
                <div class="metric-tile"><span>SW, вода</span><b class="m-sw">—</b></div>
                <div class="metric-tile"><span>признак песчаника</span><b class="m-flag">—</b></div>
              </div>
              <fieldset class="opts">
                <legend>Какой интервал даст приток нефти?</legend>
                <label class="opt-row"><input type="radio" name="volve-pick" value="A"> A, 3265–3270 м</label>
                <label class="opt-row"><input type="radio" name="volve-pick" value="B"> B, 3305–3310 м</label>
                <label class="opt-row"><input type="radio" name="volve-pick" value="C"> C, 3325–3330 м</label>
              </fieldset>
              <div><button type="button" class="btn btn-primary volve-check-btn">Проверить</button></div>
              <div class="volve-feedback" aria-live="polite" hidden></div>
              <p class="muted">{{ volve.license }}</p>
            </div>
            {% endif %}
          </section>
          {% endif %}

          {% if s.deeper %}
          <section class="block">
            <details class="more"><summary>Глубже</summary>{% for q in s.deeper %}{{ para(q) }}{% endfor %}</details>
          </section>
          {% endif %}

          {% if s.book_tasks %}
          <section id="sec-{{ s.id }}-booktasks" class="block">
            <h3>Задачи из книги</h3>
            {% for bt in s.book_tasks %}
            <div class="card">
              <p><b>Задача {{ bt.number }}.</b> {{ bt.html }} {{ src(bt.page, false) }}</p>
              {% if bt.figure %}<p class="muted">Для решения нужен {{ bt.figure }}.</p>{% endif %}
              {% if bt.errata_note %}<p class="ed-note">Исправление распознавания: {{ bt.errata_note }}</p>{% endif %}
              {% for dep in bt.dependencies %}<div class="quote"><p><b>Подтянуто к задаче ({{ dep.ref }}){{ '.' if dep.table else ':' }}</b> {{ dep.html }}</p>{% if dep.table %}{{ table(dep.table) }}{% endif %}</div>{% endfor %}
            </div>
            {% endfor %}
          </section>
          {% endif %}

          {% if s.tasks %}
          <section id="sec-{{ s.id }}-tasks" class="block">
            <h3>Задания</h3>
            {% for t in s.tasks %}
            <div class="task-card" data-task-id="{{ t.id }}">
              <p class="task-meta"><span class="chip">{{ t.type_ru }}</span>{% if t.pages %} <span class="src">стр. {{ t.pages|join(', ') }}</span>{% endif %}</p>
              <p class="task-prompt">{% for part in t.prompt_parts %}{{ part }}{% if not loop.last %}<input type="text" class="input-text gap-input" aria-label="Пропуск {{ loop.index }}" autocomplete="off">{% endif %}{% endfor %}</p>
              {% if t.type in ('single', 'multiple') %}
              <fieldset class="opts">
                <legend class="sr-only">{{ t.prompt }}</legend>
                {% for o in t.options %}<label class="opt-row"><input type="{{ 'radio' if t.type == 'single' else 'checkbox' }}" name="t-{{ t.id }}" value="{{ o.id }}"> <span>{{ o.text }}</span></label>{% endfor %}
              </fieldset>
              {% elif t.type == 'order' %}
              <ul class="order-list">
                {% for o in t.options %}
                <li class="order-item" data-opt-id="{{ o.id }}">
                  <span class="drag-handle" aria-hidden="true">⋮⋮</span>
                  <span class="order-text">{{ o.text }}</span>
                  <span class="order-btns"><button type="button" class="btn" data-move="up" aria-label="Выше">↑</button><button type="button" class="btn" data-move="down" aria-label="Ниже">↓</button></span>
                </li>
                {% endfor %}
              </ul>
              {% elif t.type == 'gap' and not t.gaps %}
              <div><input type="text" class="input-text gap-input" aria-label="Ответ" autocomplete="off"></div>
              {% elif t.type == 'calc' %}
              <div class="calc-row"><input type="text" inputmode="decimal" class="input-text calc-input" aria-label="Числовой ответ" autocomplete="off">{% if t.unit %} <span>{{ t.unit }}</span>{% endif %}</div>
              {% endif %}
              <div><button type="button" class="btn btn-primary check-task-btn">Проверить</button></div>
              <div class="task-feedback" aria-live="polite" hidden></div>
            </div>
            {% endfor %}
          </section>
          {% endif %}

          {% if s.notes %}
          <section class="block">
            <details class="more"><summary>Пометки к тексту книги: {{ s.notes|length }}</summary><ul class="facts">{% for nt in s.notes %}<li>{{ nt }}</li>{% endfor %}</ul></details>
          </section>
          {% endif %}

          <footer class="step-nav">
            {% if not loop.first %}<button type="button" class="btn" data-goto-step="{{ steps[loop.index0 - 1].id }}">← Назад</button>{% endif %}
            <button type="button" class="btn" data-mark-done="{{ s.id }}">Отметить пройденным</button>
            {% if not loop.last %}<button type="button" class="btn btn-primary" data-goto-step="{{ steps[loop.index0 + 1].id }}">Дальше: {{ steps[loop.index0 + 1].title }} →</button>{% endif %}
          </footer>
        </article>
        {% endfor %}
      </div>

      <section id="tab-path" class="tab-panel panel" hidden>
        <h2>Путь по главе</h2>
        <p class="muted">Шаги стоят в порядке для неспециалиста: термин объяснён раньше, чем понадобится.</p>
        {% for p in parts %}
        <h3>Часть {{ p.n }}{% if p.title %}. {{ p.title }}{% endif %}</h3>
        <div class="path-cards">
          {% for s in p.steps %}
          <div class="card">
            <p><a href="#step-{{ s.id }}" data-goto-step="{{ s.id }}"><b>{{ s.order }}. {{ s.title }}</b></a> <span class="src">стр. {{ s.pages_label }} · ≈ {{ s.minutes }} мин</span></p>
            <p>{{ s.main_text }}</p>
          </div>
          {% endfor %}
        </div>
        {% endfor %}
      </section>

      <section id="tab-map" class="tab-panel panel" hidden>
        <h2>Карта связей</h2>
        <p class="muted">Дуга соединяет шаг с теми, на которые он опирается. Выберите шаг, чтобы выделить его связи.</p>
        <div class="arc-map" style="--row: {{ arc.row }}px; --gutter: {{ arc.gutter }}px">
          <svg class="arcs" viewBox="0 0 {{ arc.gutter }} {{ arc.height }}" preserveAspectRatio="none" aria-hidden="true">
            {% for a in arc.arcs %}<path d="{{ a.d }}" data-from="{{ a.from }}" data-to="{{ a.to }}" vector-effect="non-scaling-stroke"/>{% endfor %}
          </svg>
          <ol class="arc-list">
            {% for s in steps %}<li><button type="button" class="arc-item" data-node="{{ s.id }}"><b>{{ s.order }}.</b> {{ s.title }}</button><button type="button" class="btn arc-open" data-goto-step="{{ s.id }}" aria-label="Открыть шаг {{ s.order }}">→</button></li>{% endfor %}
          </ol>
        </div>
      </section>

      <section id="tab-cards" class="tab-panel panel" hidden>
        <h2>Карточки повторения</h2>
        <p id="flash-status" class="muted"></p>
        <div class="flash">
          <p class="muted" id="flash-body"></p>
          <p class="flash-title" id="flash-title"></p>
          <div id="flash-back" class="callout ok" hidden></div>
          <div class="btn-row">
            <button type="button" class="btn" id="flash-flip">Показать ответ</button>
            <button type="button" class="btn btn-primary" id="flash-know">Знаю</button>
            <button type="button" class="btn" id="flash-repeat">Повторить</button>
          </div>
        </div>
      </section>

      <section id="tab-glossary" class="tab-panel panel" hidden>
        <h2>Глоссарий главы</h2>
        <label class="search">Найти термин <input type="search" class="input-text" id="glossary-search" autocomplete="off"></label>
        <dl class="terms" id="glossary-list">
          {% for s in steps %}{% for g in s.terms %}<div class="term-row"><dt>{{ g.term }}{% if g.en %} <span class="en">{{ g.en }}</span>{% endif %}</dt><dd>{{ g.definition }} <a href="#step-{{ s.id }}" data-goto-step="{{ s.id }}">шаг {{ s.order }}</a></dd></div>{% endfor %}{% endfor %}
        </dl>
      </section>

      <section id="tab-summary" class="tab-panel panel" hidden>
        <div class="summary-head no-print"><h2>Конспект главы</h2><button type="button" class="btn btn-primary" id="print-summary">Печать или PDF</button></div>
        {% for p in parts %}
        <h3>Часть {{ p.n }}{% if p.title %}. {{ p.title }}{% endif %}</h3>
        {% for s in p.steps %}
        <div class="summary-card">
          <h4>{{ s.order }}. {{ s.title }} <span class="src">стр. {{ s.pages_label }}</span></h4>
          <p>{{ s.main_text }}</p>
          {% for q in s.conditions %}{% if q.text %}<p><b>Условие.</b> {{ q.text }}</p>{% endif %}{% endfor %}
          {% for fm in s.formulas %}{% if fm.tex_rich %}<p>{{ fm.tex_rich }}</p>{% else %}<div class="math-tex" data-tex="{{ fm.tex }}" data-display="true">{{ fm.tex }}</div>{% endif %}{% endfor %}
          {% if s.misconception %}<p><b>Частая ошибка.</b> {{ s.misconception }}</p>{% endif %}
        </div>
        {% endfor %}
        {% endfor %}
      </section>

      <section id="tab-legend" class="tab-panel panel" hidden>
        <h2>Легенда цветов</h2>
        <p class="muted">Одни и те же цвета у пород, флюидов и кривых во всех рисунках и роликах. Цвет всегда продублирован подписью или формой линии.</p>
        <h3>Породы и флюиды</h3>
        <div class="legend-grid">
          {% for group in (styleguide.lithology, styleguide.fluids) %}{% for key, item in group.items() %}<div class="legend-item"><span class="swatch" style="background:{{ item.color }}"></span>{{ item.ru }}</div>{% endfor %}{% endfor %}
        </div>
        <h3>Кривые</h3>
        <div class="legend-grid">
          {% for key, item in styleguide.curves.items() %}<div class="legend-item"><span class="swatch line" style="background:{{ item.color }}"></span>{{ item.ru }}</div>{% endfor %}
        </div>
        <h3>Происхождение рисунка</h3>
        <div class="legend-grid">
          {% for key, color in styleguide.provenance.items() %}<div class="legend-item"><span class="swatch" style="background:{{ color }}"></span>{{ key }}</div>{% endfor %}
        </div>
      </section>
    </main>
  </div>
  <div id="term-pop" class="term-pop" role="status" hidden></div>
  <script id="course-data" type="application/json">{{ payload | tojson }}</script>
</body>
</html>
